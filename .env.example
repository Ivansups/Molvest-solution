# --- GigaChat (нужен для реальных ответов агента, не для /health) ---
# Кабинет: Studio → проект GigaChat API → Настройки API
# https://developers.sber.ru/docs/ru/gigachat/quickstart/ind-using-api
#
# Поля из кабинета → переменные:
#   Authorization Key  → GIGACHAT_API_KEY   (обязательно, без кавычек)
#   Scope              → GIGACHAT_SCOPE
#   Client ID          → не класть: он уже внутри Authorization Key
#   Client Secret      → не класть: только для сборки ключа, в приложение не идёт
#
# SDK сам меняет ключ на access token (OAuth, живёт ~30 мин).
# PERS — физлицо, CORP / B2B — юрлицо (должен совпадать с проектом в Studio).
GIGACHAT_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_API_URL=https://api.giga.chat/v1
# Старый хост, если новый недоступен:
# GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat-2
# Детект хэндоффа, если OpenRouter пустой/упал. Lite в API = GigaChat-2.
# GIGACHAT_CLASSIFY_MODEL=GigaChat-2
# GigaChat-2 картинки не принимает (422 "Model does not support image") —
# нужна модель линейки Pro/Max.
# GIGACHAT_VISION_MODEL=GigaChat-2-Pro
# Модель POST /embeddings. Колонка pgvector — vector(1024).
# Embeddings = 1024, Embeddings-2 = 1024, EmbeddingsGigaR = 2560
# (2560 без новой миграции не записать).
GIGACHAT_EMBEDDINGS_MODEL=Embeddings
# false — пока не установлен сертификат НУЦ Минцифры
GIGACHAT_VERIFY_SSL_CERTS=false
# Generate / Vision. Детект хэндоффа — GIGACHAT_CLASSIFY_TIMEOUT.
GIGACHAT_TIMEOUT=40.0
GIGACHAT_CLASSIFY_TIMEOUT=8.0

# --- Postgres ---
# Хост `db` — имя сервиса в docker-compose. Не меняйте, если API в Docker.
# Для `make api` (uvicorn на машине) Makefile сам подставляет localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/molvest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=molvest

# --- Redis ---
# Кэш эмбеддингов запросов и готовых ответов. Хост `redis` — имя сервиса.
REDIS_URL=redis://redis:6379/0

# --- Агент ---
CONFIDENCE_THRESHOLD=0.8
# draft — гость видит ответ ИИ пока диалог open; auto — и после эскалации;
# agent — каждый ответ ИИ остаётся черновиком, пока оператор не нажмёт «Отправить».
OPERATOR_ASSIST_MODE=draft
TOP_K=5
# Слова в чанке. Окно модели Embeddings — 512 токенов, не 1024 координат.
MAX_CHUNK_SIZE=180
CHUNK_OVERLAP=40

# --- OpenRouter (классификация хэндоффа, лёгкая LLM) ---
# Детект «позовите оператора / нужен человек» — отдельная нода графа.
# Ответы агента по-прежнему делает GigaChat. Пустой ключ — тот же детект
# через GigaChat-2 (Lite), без отключения ноды.
OPENROUTER_API_KEY=
# Базовая ссылка OpenAI-совместимого API и модель классификатора.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_TIMEOUT=5.0

# --- Bitrix24 (сценарий 1: открытые линии) ---
# Базовый URL портала, напр. https://company.bitrix24.ru. Доменные события
# входящего вебхука сравниваются с хостом этого URL.
BITRIX_PORTAL_URL=
# Пользователь приложения, от имени которого уходят исходящие сообщения в ОЛ.
BITRIX_APP_USER_ID=
# Ключ исходящего REST-вебхука: {BITRIX_PORTAL_URL}/rest/{BITRIX_APP_USER_ID}/{BITRIX_APP_TOKEN}/
BITRIX_APP_TOKEN=
# Секрет приложения для валидации входящих событий (auth.application_token в
# вебхуке коннектора ОЛ). Пустое значение = все входящие события отклоняются.
BITRIX_APPLICATION_TOKEN=
# Код и линия коннектора для imconnector.send.messages (заполнить на портале).
BITRIX_CONNECTOR_ID=
BITRIX_LINE_ID=
# OAuth локального приложения Bitrix24: imconnector.*/imbot.* требуют контекст
# приложения, BITRIX_APP_TOKEN для них не подходит. client_id/client_secret —
# из формы «Локальное приложение» на портале; сами access/refresh token
# приложение получает через POST /webhook/bitrix/install и хранит в БД.
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
# Бот открытой линии (сценарий 1 ТЗ, рядом с коннектором). Публичный URL
# API, куда Bitrix шлёт ONIMBOTMESSAGEADD (ngrok на демо). Пустое значение —
# установка приложения проходит, бот не регистрируется.
BITRIX_BOT_CODE=molvest_support
BITRIX_HANDLER_BASE_URL=

# --- Redmine HelpDesk ---
# Базовый URL портала без хвоста и ключ REST (исходящая заметка в тикет).
REDMINE_URL=
REDMINE_API_KEY=
# IMAP опционален: пустой хост — поллера нет, вебхук POST /webhook/redmine жив.
REDMINE_IMAP_HOST=
REDMINE_IMAP_PORT=993
REDMINE_IMAP_USER=
REDMINE_IMAP_PASSWORD=
REDMINE_SMTP_HOST=
REDMINE_SMTP_PORT=587
REDMINE_SMTP_USER=
REDMINE_SMTP_PASSWORD=
REDMINE_SMTP_FROM=

# --- Связка Next.js → FastAPI ---
# Пусто — backend не требует служебный токен (локальная разработка).
INTERNAL_SERVICE_TOKEN=
# В контейнере web Compose ставит http://api:8000. Для pnpm dev на хосте:
# API_INTERNAL_URL=http://127.0.0.1:8000

# --- Auth.js (вход сотрудников) ---
# Подпись JWT-куки сессии. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=dev-auth-secret-change-me
# Та же БД, что и DATABASE_URL, но драйвером Prisma (без +asyncpg) и в
# отдельной схеме `auth`: домен ведёт Alembic, поэтому prisma migrate deploy
# в public упал бы на непустой схеме (P3005).
AUTH_DATABASE_URL=postgresql://postgres:postgres@db:5432/molvest?schema=auth
