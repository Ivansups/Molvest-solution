generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

model User {
  id            String    @id(map: "pk_auth_users") @default(cuid())
  name          String?
  email         String    @unique(map: "uq_auth_users_email")
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(3)
  password      String?   @map("password_hash")
  role          String?
  accounts      Account[]
  sessions      Session[]

  @@map("auth_users")
}

model Account {
  id                String  @id(map: "pk_auth_accounts") @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_auth_accounts_user_id")

  @@index([userId], map: "ix_auth_accounts_user_id")
  @@unique([provider, providerAccountId], map: "uq_auth_accounts_provider_provider_account_id")
  @@map("auth_accounts")
}

model Session {
  id           String   @id(map: "pk_auth_sessions") @default(cuid())
  sessionToken String   @unique(map: "uq_auth_sessions_session_token") @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_auth_sessions_user_id")

  @@index([userId], map: "ix_auth_sessions_user_id")
  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique(map: "uq_auth_verification_tokens_token")
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token], map: "uq_auth_verification_tokens_identifier_token")
  @@map("auth_verification_tokens")
}
